# ── Zugangsdaten (Pflicht) ──────────────────────────────────────────────
# Google Gemini API-Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=...

# ID des Google Sheets (der lange Teil aus der Sheet-URL zwischen /d/ und /edit)
GOOGLE_SHEET_ID=...

# Pfad zur Service-Account-JSON. RELATIV zum Projektordner lassen, damit es auf
# jedem Rechner funktioniert — Datei einfach in den Ordner "secrets/" legen.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json

# ── Ordner (relativ zum Projekt) ────────────────────────────────────────
REFERENCE_DIR=references
OUTPUT_DIR=outputs

# ── Modelle ─────────────────────────────────────────────────────────────
# Lite-Bildmodell: schnell & günstig, kann aber NUR 1K. Verlangt ein Job
# 2K/4K, wechselt das Skript für diesen Job automatisch auf
# gemini-3.1-flash-image (das große Modell).
IMAGE_MODEL=gemini-3.1-flash-lite-image
PLANNER_MODEL=gemini-3.5-flash
# QC bewertet jedes Bild einzeln — das Lite-Modell ist dafür ~4-10x schneller
# und völlig ausreichend (Scoring-Aufgabe).
QC_MODEL=gemini-3.1-flash-lite

# ── Standardwerte für die Generierung ───────────────────────────────────
DEFAULT_ASPECT_RATIO=1:1
# 1K passt zum Lite-Bildmodell; 2K/4K schaltet automatisch aufs große Modell.
DEFAULT_IMAGE_SIZE=1K
DEFAULT_VARIANTS_PER_ITEM=2
MAX_RETRIES_PER_VARIANT=1
SLEEP_BETWEEN_GENERATIONS_SEC=0.5
LOG_LEVEL=INFO

# DRY_RUN=true  → es werden KEINE echten Bilder generiert (nur Testlauf)
DRY_RUN=false
